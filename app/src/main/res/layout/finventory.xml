<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_margin="6sp"
    android:orientation="vertical">
   <com.airbnb.lottie.LottieAnimationView
       android:layout_width="match_parent"
       android:layout_height="150sp"
       app:lottie_rawRes="@raw/mony_animation"
       app:lottie_autoPlay="true"
       app:lottie_loop="true"/>
  <com.google.android.material.card.MaterialCardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12sp"
      app:cardBackgroundColor="@color/white">
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:padding="12sp"
          android:gravity="center">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="افزایش  موجودی 5 هزار تومان"
              android:textStyle="bold"
              android:textColor="@color/black"/>
      </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
  <com.google.android.material.card.MaterialCardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12sp"
      app:cardBackgroundColor="@color/white">
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:padding="12sp"
          android:gravity="center">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="افزایش  موجودی 10 هزار تومان"
              android:textStyle="bold"
              android:textColor="@color/black"/>
      </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
  <com.google.android.material.card.MaterialCardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12sp"
      app:cardBackgroundColor="@color/white">
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:padding="12sp"
          android:gravity="center">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="افزایش  موجودی 100 هزار تومان"
              android:textStyle="bold"
              android:textColor="@color/black"/>
      </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
  <com.google.android.material.card.MaterialCardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12sp"
      app:cardBackgroundColor="@color/white">
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:padding="12sp"
          android:gravity="center">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="افزایش  موجودی 200 هزار تومان"
              android:textStyle="bold"
              android:textColor="@color/black"/>
      </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
  <com.google.android.material.card.MaterialCardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12sp"
      app:cardBackgroundColor="@color/white">
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:padding="12sp"
          android:gravity="center">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="افزایش  موجودی 500 هزار تومان"
              android:textStyle="bold"
              android:textColor="@color/black"/>
      </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
</LinearLayout>